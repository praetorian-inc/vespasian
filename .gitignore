# Unlike the entries above, no script builds this one: test/proto-validate's only
# consumer is `go run`, which writes to the build cache. It is listed because
# proto-validate is its own module, so `cd test/proto-validate && go build` is a
# natural thing to do by hand — not because a build step produces it.
test/proto-validate/proto-validate
